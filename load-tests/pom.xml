<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.larder</groupId>
    <artifactId>larder-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- QS-03 and QS-11 (step 12, increment 2): Gatling against a running service, only with -Pload -->
  <artifactId>load-tests</artifactId>

  <dependencies>
    <dependency>
      <groupId>io.gatling.highcharts</groupId>
      <artifactId>gatling-charts-highcharts</artifactId>
      <version>3.16.0</version>
      <scope>test</scope>
    </dependency>
    <!-- the simulation plays the Grandma Avatar on the broker (Gatling has no AMQP of its own) -->
    <dependency>
      <groupId>com.rabbitmq</groupId>
      <artifactId>amqp-client</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.gatling</groupId>
        <artifactId>gatling-maven-plugin</artifactId>
        <version>4.21.12</version>
        <configuration>
          <simulationClass>org.larder.load.HelpRequestLoadSimulation</simulationClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
